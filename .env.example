# Engine URL the browser uses to reach the API.
# Change to http://YOUR_SERVER_IP:8080 for remote / VPS deploys.
VITE_ENGINE_URL=http://localhost:8080

# Extra CORS origins the engine will accept (comma-separated).
# Leave blank for localhost-only (the default).
# Example: CORS_ORIGINS=http://myserver.com:3000,https://myserver.com
CORS_ORIGINS=
