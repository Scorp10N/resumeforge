<!DOCTYPE html>
<html lang="{{ locale }}"{% if is_rtl %} dir="rtl"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ profile.name }} — Resume</title>
  <style>
    /* ------------------------------------------------------------------ */
    /* Reset & base                                                          */
    /* ------------------------------------------------------------------ */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 10pt;
    }

    body {
      font-family: "Georgia", serif;
      color: #111111;
      background: #ffffff;
      line-height: 1.6;
    }

    /* ------------------------------------------------------------------ */
    /* Page layout                                                           */
    /* ------------------------------------------------------------------ */
    @page {
      size: A4;
      margin: 0.75in 1in;
    }

    .resume {
      max-width: 210mm;
      margin: 0 auto;
    }

    /* ------------------------------------------------------------------ */
    /* Header                                                               */
    /* ------------------------------------------------------------------ */
    .header {
      text-align: center;
      margin-bottom: 1.5em;
    }

    .header__name {
      font-size: 22pt;
      font-weight: bold;
      color: #000000;
      letter-spacing: 0.02em;
      margin-bottom: 0.2em;
    }

    .header__title {
      font-size: 10pt;
      color: #444444;
      font-style: italic;
      margin-bottom: 0.4em;
    }

    .header__contact {
      font-size: 8.5pt;
      color: #666666;
    }

    .header__contact span + span::before {
      content: " | ";
      color: #999999;
    }

    /* ------------------------------------------------------------------ */
    /* Section                                                              */
    /* ------------------------------------------------------------------ */
    .section {
      margin-top: 1.4em;
    }

    .section__heading {
      font-size: 7.5pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #000000;
      border-bottom: 1px solid #999999;
      padding-bottom: 0.15em;
      margin-bottom: 0.7em;
    }

    /* ------------------------------------------------------------------ */
    /* Summary                                                              */
    /* ------------------------------------------------------------------ */
    .summary__text {
      font-size: 10pt;
      color: #333333;
    }

    /* ------------------------------------------------------------------ */
    /* Skills                                                               */
    /* ------------------------------------------------------------------ */
    .skills__category {
      margin-bottom: 0.3em;
      font-size: 10pt;
    }

    .skills__label {
      font-weight: bold;
      color: #000000;
    }

    .skills__exploring {
      margin-top: 0.4em;
      font-size: 9.5pt;
      font-style: italic;
      color: #666666;
    }

    /* ------------------------------------------------------------------ */
    /* Experience                                                           */
    /* ------------------------------------------------------------------ */
    .position {
      margin-bottom: 1em;
    }

    .position__header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
    }

    .position__title-company {
      font-weight: bold;
      font-size: 10pt;
      color: #000000;
    }

    .position__dates {
      font-size: 9pt;
      color: #666666;
      white-space: nowrap;
    }

    .position__location {
      font-size: 9pt;
      color: #666666;
      font-style: italic;
    }

    .position__bullets {
      margin-top: 0.3em;
      padding-left: 1em;
      list-style: none;
    }

    [dir="rtl"] .position__bullets {
      padding-left: 0;
      padding-right: 1em;
    }

    .position__bullets li {
      margin-bottom: 0.2em;
      font-size: 10pt;
    }

    .position__bullets li::before {
      content: "\2212\00a0";
      color: #666666;
    }

    /* ------------------------------------------------------------------ */
    /* Education                                                            */
    /* ------------------------------------------------------------------ */
    .education__entry {
      margin-bottom: 0.7em;
    }

    .education__degree {
      font-weight: bold;
      font-size: 10pt;
      color: #000000;
    }

    .education__meta {
      font-size: 9pt;
      color: #666666;
    }

    .education__notes {
      padding-left: 1em;
      font-size: 9.5pt;
      list-style: none;
    }

    [dir="rtl"] .education__notes {
      padding-left: 0;
      padding-right: 1em;
    }

    .education__notes li::before {
      content: "\2212\00a0";
      color: #666666;
    }

    /* ------------------------------------------------------------------ */
    /* Projects                                                             */
    /* ------------------------------------------------------------------ */
    .project {
      margin-bottom: 0.8em;
    }

    .project__header {
      font-weight: bold;
      font-size: 10pt;
      color: #000000;
    }

    .project__tech {
      font-weight: normal;
      font-size: 9pt;
      font-style: italic;
      color: #666666;
    }

    .project__description {
      font-size: 10pt;
      margin-top: 0.15em;
    }

    .project__bullets {
      padding-left: 1em;
      margin-top: 0.15em;
      list-style: none;
    }

    [dir="rtl"] .project__bullets {
      padding-left: 0;
      padding-right: 1em;
    }

    .project__bullets li {
      font-size: 10pt;
      margin-bottom: 0.15em;
    }

    .project__bullets li::before {
      content: "\2212\00a0";
      color: #666666;
    }

    .project__url {
      font-size: 9pt;
      color: #444444;
    }

    /* ------------------------------------------------------------------ */
    /* Certifications                                                       */
    /* ------------------------------------------------------------------ */
    .cert__list {
      padding-left: 1em;
      list-style: none;
    }

    [dir="rtl"] .cert__list {
      padding-left: 0;
      padding-right: 1em;
    }

    .cert__list li {
      font-size: 10pt;
      margin-bottom: 0.25em;
    }

    .cert__list li::before {
      content: "\2212\00a0";
      color: #666666;
    }

    .cert__name {
      font-weight: bold;
      color: #000000;
    }

    .cert__meta {
      color: #666666;
      font-size: 9.5pt;
    }
  </style>
</head>
<body>
<div class="resume">

  <!-- ================================================================ -->
  <!-- Header                                                           -->
  <!-- ================================================================ -->
  <header class="header">
    <div class="header__name">{{ profile.name }}</div>
    {% if profile.title %}
    <div class="header__title">{{ profile.title }}</div>
    {% endif %}
    <div class="header__contact">
      {% if profile.email %}<span>{{ profile.email }}</span>{% endif %}
      {% if profile.phone %}<span>{{ profile.phone }}</span>{% endif %}
      {% if profile.linkedin %}<span>{{ profile.linkedin }}</span>{% endif %}
      {% if profile.location %}<span>{{ profile.location }}</span>{% endif %}
    </div>
  </header>

  <!-- ================================================================ -->
  <!-- Summary                                                          -->
  <!-- ================================================================ -->
  {% if profile.summary %}
  <section class="section">
    <div class="section__heading">Summary</div>
    <p class="summary__text">{{ profile.summary }}</p>
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Skills                                                           -->
  <!-- ================================================================ -->
  {% if skills.categories %}
  <section class="section">
    <div class="section__heading">Skills</div>
    {% for cat in skills.categories | sort(attribute='priority') %}
    <div class="skills__category">
      <span class="skills__label">{{ cat.label }}:</span>
      {{ cat.items | join(', ') }}
    </div>
    {% endfor %}
    {% if skills.exploring %}
    <div class="skills__exploring">
      Currently Exploring:
      {% for item in skills.exploring %}{{ item.label }}: {{ item.items | join(', ') }}{% if not loop.last %}; {% endif %}{% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Experience                                                        -->
  <!-- ================================================================ -->
  {% if experience.positions %}
  <section class="section">
    <div class="section__heading">Experience</div>
    {% for pos in experience.positions | sort(attribute='priority') %}
    <div class="position">
      <div class="position__header">
        <span class="position__title-company">{{ pos.title }} &mdash; {{ pos.company }}</span>
        <span class="position__dates">{{ pos.start_date }} &ndash; {{ 'Present' if pos.is_current else (pos.end_date or '') }}</span>
      </div>
      {% if pos.location %}
      <div class="position__location">{{ pos.location }}</div>
      {% endif %}
      {% if pos.bullets %}
      <ul class="position__bullets">
        {% for bullet in pos.bullets %}
        <li>{{ bullet.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Education                                                         -->
  <!-- ================================================================ -->
  {% if education.entries %}
  <section class="section">
    <div class="section__heading">Education</div>
    {% for edu in education.entries | sort(attribute='priority') %}
    <div class="education__entry">
      <div class="education__degree">
        {{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %} &mdash; {{ edu.institution }}
      </div>
      <div class="education__meta">
        {{ edu.start_date }} &ndash; {{ edu.end_date or 'Present' }}
        {% if edu.location %} | {{ edu.location }}{% endif %}
        {% if edu.gpa %} | GPA: {{ edu.gpa }}{% endif %}
      </div>
      {% if edu.notes %}
      <ul class="education__notes">
        {% for note in edu.notes %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Projects                                                          -->
  <!-- ================================================================ -->
  {% if projects.projects %}
  <section class="section">
    <div class="section__heading">Projects</div>
    {% for proj in projects.projects | sort(attribute='priority') %}
    <div class="project">
      <div class="project__header">
        {{ proj.name }}
        {% if proj.technologies %}
        <span class="project__tech">({{ proj.technologies | join(', ') }})</span>
        {% endif %}
      </div>
      <div class="project__description">{{ proj.description }}</div>
      {% if proj.bullets %}
      <ul class="project__bullets">
        {% for bullet in proj.bullets %}
        <li>{{ bullet.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if proj.url %}
      <div class="project__url">{{ proj.url }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Certifications                                                    -->
  <!-- ================================================================ -->
  {% if certifications.certifications %}
  <section class="section">
    <div class="section__heading">Certifications</div>
    <ul class="cert__list">
      {% for cert in certifications.certifications %}
      <li>
        <span class="cert__name">{{ cert.name }}</span>
        <span class="cert__meta">&mdash; {{ cert.issuer }} ({{ cert.date }}){% if cert.expiry %} &middot; Expires {{ cert.expiry }}{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

</div>
</body>
</html>
