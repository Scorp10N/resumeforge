<!DOCTYPE html>
<html lang="{{ locale }}"{% if is_rtl %} dir="rtl"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ profile.name }} — Resume</title>
  <style>
    /* ------------------------------------------------------------------ */
    /* Reset & base                                                          */
    /* ------------------------------------------------------------------ */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 11pt;
    }

    body {
      font-family: "Garamond", "Georgia", serif;
      color: #222222;
      background: #ffffff;
      line-height: 1.55;
    }

    /* ------------------------------------------------------------------ */
    /* Page layout                                                           */
    /* ------------------------------------------------------------------ */
    @page {
      size: A4;
      margin: 0.65in 0.85in;
    }

    .resume {
      max-width: 210mm;
      margin: 0 auto;
    }

    /* ------------------------------------------------------------------ */
    /* Header                                                               */
    /* ------------------------------------------------------------------ */
    .header {
      margin-bottom: 1.2em;
      padding-bottom: 0.6em;
      border-bottom: 2px solid #8B7355;
    }

    .header__name {
      font-size: 22pt;
      font-weight: bold;
      color: #1a1a2e;
      letter-spacing: 0.03em;
      margin-bottom: 0.1em;
    }

    .header__tagline {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 1em;
      font-size: 10pt;
      color: #555555;
    }

    .header__title {
      font-size: 11pt;
      color: #8B7355;
      font-style: italic;
    }

    .header__contact span + span::before {
      content: " \00a0\00b7\00a0 ";
      color: #999999;
    }

    /* ------------------------------------------------------------------ */
    /* Section                                                              */
    /* ------------------------------------------------------------------ */
    .section {
      margin-top: 1.3em;
    }

    .section__heading {
      font-size: 11pt;
      font-weight: bold;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: #1a1a2e;
      border-bottom: 2px solid #8B7355;
      padding-bottom: 0.15em;
      margin-bottom: 0.65em;
    }

    /* ------------------------------------------------------------------ */
    /* Summary                                                              */
    /* ------------------------------------------------------------------ */
    .summary__text {
      font-size: 11pt;
      color: #333333;
    }

    /* ------------------------------------------------------------------ */
    /* Experience                                                           */
    /* ------------------------------------------------------------------ */
    .position {
      margin-bottom: 1.1em;
    }

    .position__header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
    }

    .position__title-company {
      font-weight: bold;
      font-size: 11pt;
      color: #1a1a2e;
    }

    .position__dates {
      font-size: 10pt;
      color: #666666;
      white-space: nowrap;
      font-style: italic;
    }

    .position__location {
      font-size: 10pt;
      color: #666666;
      font-style: italic;
    }

    .position__bullets {
      margin-top: 0.35em;
      padding-left: 0;
      list-style: none;
    }

    [dir="rtl"] .position__bullets {
      padding-right: 0;
    }

    .position__bullets li {
      margin-bottom: 0.2em;
      font-size: 11pt;
      padding-left: 1.4em;
      text-indent: -1.4em;
    }

    [dir="rtl"] .position__bullets li {
      padding-left: 0;
      padding-right: 1.4em;
      text-indent: 1.4em;
    }

    .position__bullets li::before {
      content: "\2014\00a0";
      color: #8B7355;
    }

    /* ------------------------------------------------------------------ */
    /* Education                                                            */
    /* ------------------------------------------------------------------ */
    .education__entry {
      margin-bottom: 0.8em;
    }

    .education__degree {
      font-weight: bold;
      font-size: 11pt;
      color: #1a1a2e;
    }

    .education__meta {
      font-size: 10pt;
      color: #666666;
      font-style: italic;
    }

    .education__notes {
      padding-left: 1.4em;
      font-size: 10.5pt;
      list-style: none;
    }

    [dir="rtl"] .education__notes {
      padding-left: 0;
      padding-right: 1.4em;
    }

    .education__notes li::before {
      content: "\2014\00a0";
      color: #8B7355;
    }

    /* ------------------------------------------------------------------ */
    /* Projects                                                             */
    /* ------------------------------------------------------------------ */
    .project {
      margin-bottom: 0.9em;
    }

    .project__header {
      font-weight: bold;
      font-size: 11pt;
      color: #1a1a2e;
    }

    .project__tech {
      font-weight: normal;
      font-size: 10pt;
      font-style: italic;
      color: #8B7355;
    }

    .project__description {
      font-size: 11pt;
      margin-top: 0.15em;
    }

    .project__bullets {
      padding-left: 0;
      margin-top: 0.2em;
      list-style: none;
    }

    .project__bullets li {
      font-size: 11pt;
      margin-bottom: 0.15em;
      padding-left: 1.4em;
      text-indent: -1.4em;
    }

    [dir="rtl"] .project__bullets li {
      padding-left: 0;
      padding-right: 1.4em;
      text-indent: 1.4em;
    }

    .project__bullets li::before {
      content: "\2014\00a0";
      color: #8B7355;
    }

    .project__url {
      font-size: 10pt;
      color: #555555;
    }

    /* ------------------------------------------------------------------ */
    /* Skills                                                               */
    /* ------------------------------------------------------------------ */
    .skills__category {
      margin-bottom: 0.3em;
      font-size: 11pt;
    }

    .skills__label {
      font-weight: bold;
      color: #1a1a2e;
    }

    .skills__exploring {
      margin-top: 0.4em;
      font-size: 10.5pt;
      font-style: italic;
      color: #666666;
    }

    /* ------------------------------------------------------------------ */
    /* Certifications                                                       */
    /* ------------------------------------------------------------------ */
    .cert__list {
      padding-left: 0;
      list-style: none;
    }

    .cert__list li {
      font-size: 11pt;
      margin-bottom: 0.3em;
      padding-left: 1.4em;
      text-indent: -1.4em;
    }

    [dir="rtl"] .cert__list li {
      padding-left: 0;
      padding-right: 1.4em;
      text-indent: 1.4em;
    }

    .cert__list li::before {
      content: "\2014\00a0";
      color: #8B7355;
    }

    .cert__name {
      font-weight: bold;
      color: #1a1a2e;
    }

    .cert__meta {
      color: #666666;
      font-size: 10.5pt;
    }
  </style>
</head>
<body>
<div class="resume">

  <!-- ================================================================ -->
  <!-- Header                                                           -->
  <!-- ================================================================ -->
  <header class="header">
    <div class="header__name">{{ profile.name }}</div>
    <div class="header__tagline">
      {% if profile.title %}<span class="header__title">{{ profile.title }}</span>{% endif %}
      <span>
        {% if profile.email %}<span>{{ profile.email }}</span>{% endif %}
        {% if profile.phone %}<span>{{ profile.phone }}</span>{% endif %}
        {% if profile.linkedin %}<span>{{ profile.linkedin }}</span>{% endif %}
        {% if profile.location %}<span>{{ profile.location }}</span>{% endif %}
      </span>
    </div>
  </header>

  <!-- ================================================================ -->
  <!-- Summary                                                          -->
  <!-- ================================================================ -->
  {% if profile.summary %}
  <section class="section">
    <div class="section__heading">Executive Summary</div>
    <p class="summary__text">{{ profile.summary }}</p>
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Experience                                                        -->
  <!-- ================================================================ -->
  {% if experience.positions %}
  <section class="section">
    <div class="section__heading">Professional Experience</div>
    {% for pos in experience.positions | sort(attribute='priority') %}
    <div class="position">
      <div class="position__header">
        <span class="position__title-company">{{ pos.title }} &mdash; {{ pos.company }}</span>
        <span class="position__dates">{{ pos.start_date }} &ndash; {{ 'Present' if pos.is_current else (pos.end_date or '') }}</span>
      </div>
      {% if pos.location %}
      <div class="position__location">{{ pos.location }}</div>
      {% endif %}
      {% if pos.bullets %}
      <ul class="position__bullets">
        {% for bullet in pos.bullets %}
        <li>{{ bullet.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Education                                                         -->
  <!-- ================================================================ -->
  {% if education.entries %}
  <section class="section">
    <div class="section__heading">Education</div>
    {% for edu in education.entries | sort(attribute='priority') %}
    <div class="education__entry">
      <div class="education__degree">
        {{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %} &mdash; {{ edu.institution }}
      </div>
      <div class="education__meta">
        {{ edu.start_date }} &ndash; {{ edu.end_date or 'Present' }}
        {% if edu.location %} &middot; {{ edu.location }}{% endif %}
        {% if edu.gpa %} &middot; GPA: {{ edu.gpa }}{% endif %}
      </div>
      {% if edu.notes %}
      <ul class="education__notes">
        {% for note in edu.notes %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Projects                                                          -->
  <!-- ================================================================ -->
  {% if projects.projects %}
  <section class="section">
    <div class="section__heading">Notable Projects</div>
    {% for proj in projects.projects | sort(attribute='priority') %}
    <div class="project">
      <div class="project__header">
        {{ proj.name }}
        {% if proj.technologies %}
        <span class="project__tech">({{ proj.technologies | join(', ') }})</span>
        {% endif %}
      </div>
      <div class="project__description">{{ proj.description }}</div>
      {% if proj.bullets %}
      <ul class="project__bullets">
        {% for bullet in proj.bullets %}
        <li>{{ bullet.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if proj.url %}
      <div class="project__url">{{ proj.url }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Skills                                                            -->
  <!-- ================================================================ -->
  {% if skills.categories %}
  <section class="section">
    <div class="section__heading">Core Competencies</div>
    {% for cat in skills.categories | sort(attribute='priority') %}
    <div class="skills__category">
      <span class="skills__label">{{ cat.label }}:</span>
      {{ cat.items | join(', ') }}
    </div>
    {% endfor %}
    {% if skills.exploring %}
    <div class="skills__exploring">
      Currently Exploring:
      {% for item in skills.exploring %}{{ item.label }}: {{ item.items | join(', ') }}{% if not loop.last %}; {% endif %}{% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <!-- ================================================================ -->
  <!-- Certifications                                                    -->
  <!-- ================================================================ -->
  {% if certifications.certifications %}
  <section class="section">
    <div class="section__heading">Certifications</div>
    <ul class="cert__list">
      {% for cert in certifications.certifications %}
      <li>
        <span class="cert__name">{{ cert.name }}</span>
        <span class="cert__meta">&mdash; {{ cert.issuer }} ({{ cert.date }}){% if cert.expiry %} &middot; Expires {{ cert.expiry }}{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

</div>
</body>
</html>
