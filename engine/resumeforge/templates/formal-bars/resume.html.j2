<!DOCTYPE html>
<html lang="{{ locale }}"{% if is_rtl %} dir="rtl"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ profile.name }} — Resume</title>
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 10pt;
    }

    body {
      background: #ffffff;
      color: #000000;
      font-family: Arial, Calibri, sans-serif;
      line-height: 1.28;
    }

    .page-ribbon {
      background: #DDECC6;
      border-left: 0.6pt solid #AABF8D;
      bottom: -0.55in;
      position: fixed;
      right: -0.27in;
      top: -0.65in;
      width: 0.27in;
      z-index: -1;
    }

    @page {
      size: A4;
      margin: 0.65in 0.27in 0.55in 0.55in;
    }

    .resume {
      max-width: 210mm;
      margin: 0 auto;
    }

    .header {
      padding-top: 0.32in;
      margin-bottom: 1.85em;
    }

    .header__name,
    .header__contact,
    .header__title {
      color: #86A6E8;
      font-weight: 400;
    }

    .header__name {
      font-size: 12pt;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .header__title {
      font-size: 10.5pt;
      margin-top: 0.08em;
    }

    .header__contact {
      font-size: 11.5pt;
      margin-top: 0.08em;
    }

    .header__contact span + span::before {
      color: #86A6E8;
      content: " | ";
      padding: 0 0.35em;
    }

    .bar {
      background: #B8B8B8;
      border: 0.6pt solid #606060;
      height: 10pt;
      margin: 0.35em 0 0.35em;
      width: 100%;
    }

    .section {
      margin-top: 1.55em;
    }

    .section--profile {
      margin-top: 0;
    }

    .section__heading {
      color: #000000;
      font-size: 10pt;
      font-weight: 700;
      margin-bottom: 0.25em;
      text-transform: uppercase;
    }

    .profile__bullets {
      list-style: none;
      margin-bottom: 0.5em;
    }

    .profile__bullets li {
      font-size: 11pt;
      margin-bottom: 0.12em;
      padding-left: 1.05em;
      position: relative;
    }

    .profile__bullets li::before {
      content: "▶";
      font-size: 8pt;
      left: 0.05em;
      position: absolute;
      top: 0.16em;
    }

    [dir="rtl"] .profile__bullets li {
      padding-left: 0;
      padding-right: 1.05em;
    }

    [dir="rtl"] .profile__bullets li::before {
      left: auto;
      right: 0.05em;
    }

    .position {
      margin-bottom: 1.55em;
      page-break-inside: avoid;
    }

    .position__header {
      align-items: baseline;
      display: flex;
      justify-content: space-between;
      gap: 1.2em;
    }

    .position__company {
      font-size: 10.5pt;
      font-weight: 700;
    }

    .position__dates {
      flex-shrink: 0;
      font-size: 10pt;
      font-weight: 700;
      white-space: nowrap;
    }

    .position__dates::before {
      content: "| ";
      font-weight: 700;
    }

    .position__title {
      font-size: 10pt;
      font-weight: 700;
      margin-top: 0.1em;
    }

    .position__location {
      color: #333333;
      font-size: 9.5pt;
      font-style: italic;
      margin-top: 0.08em;
    }

    .position__bullets {
      margin-top: 1.25em;
      padding-left: 2.1em;
    }

    [dir="rtl"] .position__bullets {
      padding-left: 0;
      padding-right: 2.1em;
    }

    .position__bullets li {
      font-size: 10.5pt;
      margin-bottom: 0.2em;
      padding-left: 0.45em;
    }

    .skills__category,
    .education__entry,
    .project,
    .cert__list li {
      font-size: 10pt;
      margin-bottom: 0.25em;
    }

    .skills__label,
    .education__degree,
    .project__header,
    .cert__name {
      font-weight: 700;
    }

    .education__meta,
    .cert__meta,
    .project__tech,
    .project__url {
      color: #333333;
      font-size: 9.5pt;
    }

    .education__notes,
    .project__bullets,
    .cert__list {
      padding-left: 1.5em;
    }

    [dir="rtl"] .education__notes,
    [dir="rtl"] .project__bullets,
    [dir="rtl"] .cert__list {
      padding-left: 0;
      padding-right: 1.5em;
    }
  </style>
</head>
<body>
<div class="page-ribbon"></div>
<div class="resume">
  <header class="header">
    <div class="header__name">{{ profile.name }}</div>
    {% if profile.title %}
    <div class="header__title">{{ profile.title }}</div>
    {% endif %}
    <div class="header__contact">
      {% if profile.phone %}<span>{{ profile.phone }}</span>{% endif %}
      {% if profile.email %}<span>{{ profile.email }}</span>{% endif %}
      {% if profile.linkedin %}<span>{{ profile.linkedin }}</span>{% endif %}
      {% if profile.github %}<span>{{ profile.github }}</span>{% endif %}
      {% if profile.website %}<span>{{ profile.website }}</span>{% endif %}
      {% if profile.location %}<span>{{ profile.location }}</span>{% endif %}
    </div>
  </header>

  {% if profile.summary %}
  <section class="section section--profile">
    <div class="bar"></div>
    <div class="section__heading">Profile</div>
    <ul class="profile__bullets">
      {% set summary_lines = profile.summary.splitlines() %}
      {% for line in summary_lines if line.strip() %}
      <li>{{ line.strip() }}</li>
      {% else %}
      <li>{{ profile.summary }}</li>
      {% endfor %}
    </ul>
    <div class="bar"></div>
  </section>
  {% endif %}

  {% if experience.positions %}
  <section class="section">
    {% for pos in experience.positions | sort(attribute='priority') %}
    <div class="position">
      <div class="position__header">
        <div class="position__company">{{ pos.company }}</div>
        <div class="position__dates">{{ format_date(pos.start_date, locale) }}&ndash;{{ _("Present") if pos.is_current else (format_date(pos.end_date, locale) or "") }}</div>
      </div>
      <div class="position__title">{{ pos.title }}</div>
      {% if pos.location %}
      <div class="position__location">{{ pos.location }}</div>
      {% endif %}
      {% if pos.bullets %}
      <ul class="position__bullets">
        {% for bullet in pos.bullets %}
        <li>{{ bullet.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if skills.categories %}
  <section class="section">
    <div class="bar"></div>
    <div class="section__heading">{{ _("Core Competencies") }}</div>
    {% for cat in skills.categories | sort(attribute='priority') %}
    <div class="skills__category">
      <span class="skills__label">{{ cat.label }}:</span>
      {{ cat.items | join(', ') }}
    </div>
    {% endfor %}
    {% if skills.exploring %}
    <div class="skills__category">
      <span class="skills__label">{{ _("Exploring") }}:</span>
      {% for item in skills.exploring %}{{ item.label }}: {{ item.items | join(', ') }}{% if not loop.last %}; {% endif %}{% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  {% if education.entries %}
  <section class="section">
    <div class="bar"></div>
    <div class="section__heading">{{ _("Education") }}</div>
    {% for edu in education.entries | sort(attribute='priority') %}
    <div class="education__entry">
      <div class="education__degree">{{ edu.degree }}{% if edu.field %} in {{ edu.field }}{% endif %} — {{ edu.institution }}</div>
      <div class="education__meta">
        {{ format_date(edu.start_date, locale) }}&ndash;{{ format_date(edu.end_date, locale) or _("Present") }}
        {% if edu.location %} | {{ edu.location }}{% endif %}
        {% if edu.gpa %} | GPA: {{ edu.gpa }}{% endif %}
      </div>
      {% if edu.notes %}
      <ul class="education__notes">
        {% for note in edu.notes %}
        <li>{{ note }}</li>
        {% endfor %}
      </ul>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if projects.projects %}
  <section class="section">
    <div class="bar"></div>
    <div class="section__heading">{{ _("Projects") }}</div>
    {% for proj in projects.projects | sort(attribute='priority') %}
    <div class="project">
      <div class="project__header">
        {{ proj.name }}
        {% if proj.technologies %}<span class="project__tech">({{ proj.technologies | join(', ') }})</span>{% endif %}
      </div>
      <div>{{ proj.description }}</div>
      {% if proj.bullets %}
      <ul class="project__bullets">
        {% for bullet in proj.bullets %}
        <li>{{ bullet.text }}</li>
        {% endfor %}
      </ul>
      {% endif %}
      {% if proj.url %}
      <div class="project__url">{{ proj.url }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if certifications.certifications %}
  <section class="section">
    <div class="bar"></div>
    <div class="section__heading">{{ _("Certifications") }}</div>
    <ul class="cert__list">
      {% for cert in certifications.certifications %}
      <li>
        <span class="cert__name">{{ cert.name }}</span>
        <span class="cert__meta">— {{ cert.issuer }} ({{ cert.date }}){% if cert.expiry %}; Expires {{ cert.expiry }}{% endif %}</span>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}
</div>
</body>
</html>
